generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model College {
  id             String   @id @default(cuid())
  name           String
  code           String   @unique
  latitude       Float
  longitude      Float
  address        String
  reportingTime  String   @default("09:00")
  geofenceRadius Float    @default(100.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users       User[]
  students    Student[]
  drivers     Driver[]
  buses       Bus[]
  routes      Route[]
  trips       Trip[]
  busArrivals BusArrival[]
  incidents   Incident[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  phone        String?
  passwordHash String
  role         String   @default("STUDENT") // STUDENT, DRIVER, ADMIN
  collegeId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  college           College                  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  student           Student?
  driver            Driver?
  pushSubscriptions PushSubscriptionRecord[]
}

model Student {
  id              String   @id @default(cuid())
  userId          String   @unique
  rollNumber      String
  village         String
  boardingPointId String
  routeId         String
  collegeId       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college               College                 @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  route                 Route                   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  boardingPoint         BoardingPoint           @relation(fields: [boardingPointId], references: [id], onDelete: Cascade)
  notifications         Notification[]
  preferences           NotificationPreference?
  boardingConfirmations BoardingConfirmation[]
  guardianLinks         GuardianTrackingLink[]

  @@unique([collegeId, rollNumber])
}

model Driver {
  id             String   @id @default(cuid())
  userId         String   @unique
  driverName     String
  phone          String?
  collegeId      String
  assignedBusId  String?
  status         String   @default("AVAILABLE") // AVAILABLE, ON_TRIP, OFFLINE
  approvalStatus String   @default("PENDING")   // PENDING, APPROVED, REJECTED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  college       College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  assignedBus   Bus?           @relation("DriverAssignedBus", fields: [assignedBusId], references: [id], onDelete: SetNull)
  busesDriven   Bus[]          @relation("BusDriver")
  trips         Trip[]
  liveLocations LiveLocation[]
  busArrivals   BusArrival[]
  incidents     Incident[]
}

model Bus {
  id                 String    @id @default(cuid())
  busNumber          String
  capacity           Int       @default(40)
  currentOccupancy   Int       @default(0)
  occupancyStatus    String    @default("UNKNOWN") // LOW, MEDIUM, HIGH, FULL, UNKNOWN
  occupancyUpdatedAt DateTime?
  occupancyUpdatedBy String?
  collegeId          String
  routeId            String?
  assignedDriverId   String?
  status             String    @default("INACTIVE") // ACTIVE, INACTIVE, MAINTENANCE
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  college           College                @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  route             Route?                 @relation(fields: [routeId], references: [id], onDelete: SetNull)
  assignedDriver    Driver?                @relation("BusDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  driversAssignedTo Driver[]               @relation("DriverAssignedBus")
  trips             Trip[]
  liveLocation      LiveLocation?
  locationHistories LocationHistory[]
  busArrivals       BusArrival[]
  guardianLinks     GuardianTrackingLink[]
  incidents         Incident[]

  @@unique([collegeId, busNumber])
}

model Route {
  id                   String   @id @default(cuid())
  name                 String
  routeNumber          String
  collegeId            String
  destinationCollegeId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  college        College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  buses          Bus[]
  boardingPoints BoardingPoint[]
  students       Student[]

  @@unique([collegeId, routeNumber])
}

model BoardingPoint {
  id        String   @id @default(cuid())
  name      String
  latitude  Float
  longitude Float
  routeId   String
  sequence  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  route    Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  students Student[]
}

model Trip {
  id                String    @id @default(cuid())
  busId             String
  driverId          String
  collegeId         String
  tripType          String    @default("MORNING_PICKUP") // MORNING_PICKUP, EVENING_RETURN
  originName        String?
  destinationName   String?
  destinationLat    Float?
  destinationLng    Float?
  finalStopId       String?
  startTime         DateTime  @default(now())
  endTime           DateTime?
  status            String    @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  arrivalTime       DateTime?
  arrivalStatus     String?   // ON_TIME, DELAYED
  delayMinutes      Int       @default(0)
  isDelayedNotified Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  bus                   Bus                    @relation(fields: [busId], references: [id], onDelete: Cascade)
  driver                Driver                 @relation(fields: [driverId], references: [id], onDelete: Cascade)
  college               College                @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  liveLocations         LiveLocation[]
  locationHistories     LocationHistory[]
  notifications         Notification[]
  busArrival            BusArrival?
  boardingConfirmations BoardingConfirmation[]
}

model LiveLocation {
  busId     String   @id
  tripId    String
  driverId  String
  latitude  Float
  longitude Float
  accuracy  Float    @default(5.0)
  speed     Float    @default(0.0)
  heading   Float    @default(0.0)
  timestamp DateTime @default(now())
  isStale   Boolean  @default(false)

  bus    Bus    @relation(fields: [busId], references: [id], onDelete: Cascade)
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model LocationHistory {
  id        String   @id @default(cuid())
  busId     String
  tripId    String
  latitude  Float
  longitude Float
  accuracy  Float    @default(5.0)
  speed     Float    @default(0.0)
  heading   Float    @default(0.0)
  timestamp DateTime @default(now())

  bus  Bus  @relation(fields: [busId], references: [id], onDelete: Cascade)
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  studentId String
  tripId    String
  type      String    @default("APPROACHING_2KM") // APPROACHING_2KM, APPROACHING_2STOPS, TRIP_STARTED, TRIP_ENDED, SERVICE_DISRUPTION
  channel   String    @default("IN_APP") // IN_APP, WEB_PUSH, SMS, WHATSAPP
  message   String
  busId     String?
  busNumber String?
  readAt    DateTime?
  sentAt    DateTime  @default(now())
  status    String    @default("SENT")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([studentId, tripId, type])
}

model NotificationPreference {
  id                String   @id @default(cuid())
  studentId         String   @unique
  busArrivalAlerts  Boolean  @default(true)
  thresholdType     String   @default("DISTANCE_2KM") // DISTANCE_2KM, STOPS_2, BOTH
  enableWebPush     Boolean  @default(true)
  enableSms         Boolean  @default(false)
  enableWhatsApp    Boolean  @default(false)
  phoneNumber       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model PushSubscriptionRecord {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BoardingConfirmation {
  id          String   @id @default(cuid())
  studentId   String
  tripId      String
  status      String   @default("ON_BOARD") // ON_BOARD, ALIGHTED
  confirmedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([studentId, tripId])
}

model GuardianTrackingLink {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  studentId String
  busId     String
  tripId    String?
  label     String?
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bus     Bus     @relation(fields: [busId], references: [id], onDelete: Cascade)
}

model Incident {
  id              String    @id @default(cuid())
  collegeId       String
  busId           String
  driverId        String
  tripId          String?
  type            String    // SOS, BREAKDOWN, DELAY, ASSISTANCE
  severity        String    @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW
  status          String    @default("OPEN") // OPEN, ACKNOWLEDGED, DISPATCHED, RESOLVED, CANCELLED
  description     String?
  delayMinutes    Int       @default(0)
  latitude        Float?
  longitude       Float?
  accuracy        Float?
  reportedAt      DateTime  @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  resolutionNotes String?

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  bus     Bus     @relation(fields: [busId], references: [id], onDelete: Cascade)
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model BusArrival {
  id                String   @id @default(cuid())
  tripId            String   @unique
  busId             String
  driverId          String
  collegeId         String
  routeId           String?
  date              String   // YYYY-MM-DD
  arrivalTime       DateTime @default(now())
  reportingTime     String   @default("09:00")
  status            String   // ON_TIME, DELAYED
  delayMinutes      Int      @default(0)
  distanceAtArrival Float    @default(0.0)
  createdAt         DateTime @default(now())

  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  bus     Bus     @relation(fields: [busId], references: [id], onDelete: Cascade)
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}
